# Copia este archivo como .env (no se sube a GitHub) y completa los valores.

# Conexión a PostgreSQL.
#  - Local o desde tu PC contra Railway: Railway > servicio Postgres > Variables > DATABASE_PUBLIC_URL
#  - Dentro de Railway (servicio de la app): usa la referencia  ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:CONTRASEÑA@HOST.proxy.rlwy.net:PUERTO/railway

# Clave para firmar las sesiones. Genera una larga y aleatoria con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# true = la pantalla de acceso muestra las cuentas de prueba. En producción real déjalo en false.
DEMO_MODE=false
